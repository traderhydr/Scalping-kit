TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
# ALLOWED_CHAT_IDS=111111,222222        # optional: restrict who can use the bot (use /chatid to find yours)
# BINANCE_MARKET=futures                # futures | spot
# TAKE_PROFIT_RR=0.5,1,1.5,2.5         # 4 take-profits, in multiples of the stop distance
# ENTRY_STEP_R=0.15                     # entries 2 and 3 sit this many R deeper into the pullback
# PAC_LENGTH=34
# FAST_EMA=89
# MEDIUM_EMA=200
# PULLBACK_LOOKBACK=3
# USE_HEIKIN_ASHI=true
# CHANNEL_ID=-1001234567890             # channel where every signal is also posted (bot must be channel admin)
# AUTO_SCAN_COUNT=15                    # auto-scan top N coins by 24h volume (0 = off); signals go to CHANNEL_ID (or ALLOWED_CHAT_IDS)
# AUTO_SCAN_TIMEFRAMES=5m,15m
# AUTO_SCAN_EXCHANGES=binance,blofin
# LEVERAGE=15
# MARGIN_MODE=Cross                     # Cross | Isolated
# AUTO_SCAN_EXCLUDE=SOXL,SOXS,SNDK,XAU,XAG,SKHYNIX,KORU,SPCX,MU,CL   # base symbols to skip (replaces the default list)
# QUIET_HOURS=13:00-16:15,19:30-23:15  # no new signals in these windows (also settable with /quiet in Telegram)
# QUIET_TZ=Europe/Madrid
